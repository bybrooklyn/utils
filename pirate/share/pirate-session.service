[Unit]
Description=pirate: qBittorrent (VPN namespace) for this desktop session
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@PIRATE@ session-start
ExecStop=@PIRATE@ session-stop
TimeoutStartSec=30
TimeoutStopSec=100

[Install]
WantedBy=graphical-session.target
