# lealand (~/utils/lealand), the ll command: walk around with the arrows, qq to cd where you ended up.
# The binary prints the folder and maybe a command; this does the cd and runs it.
unalias ll 2>/dev/null
ll() {
    local out
    out=$(command ll "$@") || return
    [[ -n $out ]] || return 0
    cd -- "${out%%$'\n'*}" || return
    [[ $out == *$'\n'* ]] && eval "${out#*$'\n'}"
}
alias lealand=ll
# every cd counts towards lealand's / jump
zmodload zsh/datetime
_ll_visit() { { print -r -- "$EPOCHSECONDS $PWD" >>| ${XDG_DATA_HOME:-$HOME/.local/share}/lealand/visits } 2>/dev/null }
autoload -Uz add-zsh-hook && add-zsh-hook chpwd _ll_visit
